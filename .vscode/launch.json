{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Remote Docker Debug",
            "type": "python",
            "request": "attach",
            "connect": {
                "host": "localhost",
                "port": 5678
            },
            "pathMappings": [
                {
                    "localRoot": "${workspaceFolder}",
                    "remoteRoot": "/code"
                },
                {
                    "localRoot": "${workspaceFolder}/app",
                    "remoteRoot": "/code/app"
                }
            ],
            "justMyCode": false,
            "console": "integratedTerminal",
            "redirectOutput": true
        }
    ]
}